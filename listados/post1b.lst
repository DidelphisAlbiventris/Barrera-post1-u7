    55                              <1> ; Solo la PREPARACION usa BIOS. El dibujo posterior usa exclusivamente B800h.
    56                              <1> iniciar_directo:
    57 000000DF B80300              <1>     mov ax, 0003h            ; establecer formato conocido antes de B800h
    58 000000E2 CD10                <1>     int 10h
