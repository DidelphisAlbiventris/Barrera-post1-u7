    33 000000BF AC                  <1>     lodsb
    34 000000C0 84C0                <1>     test al, al
    35 000000C2 7415                <1>     jz .fin
    36 000000C4 50                  <1>     push ax                  ; AH=02h no debe destruir el caracter pendiente
    37 000000C5 B402                <1>     mov ah, 02h
    38 000000C7 30FF                <1>     xor bh, bh
    39 000000C9 CD10                <1>     int 10h
    40 000000CB 58                  <1>     pop ax
