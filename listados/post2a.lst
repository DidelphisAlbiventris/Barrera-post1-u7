    21 0000010B C3                  <1>     ret
    22                              <1> 
    23                              <1> ; DS:SI cadena, DH fila, DL columna, BL atributo. Pagina cero.
    24                              <1> ; AH=09h no avanza el cursor: se actualiza DL explicitamente.
    25                              <1> cadena_bios:
    26 0000010C 50                  <1>     push ax
    27 0000010D 53                  <1>     push bx
    28 0000010E 51                  <1>     push cx
    29 0000010F 52                  <1>     push dx
    30 00000110 56                  <1>     push si
    31 00000111 FC                  <1>     cld
    32                              <1> .siguiente:
    33 00000112 AC                  <1>     lodsb
    34 00000113 84C0                <1>     test al, al
    35 00000115 7415                <1>     jz .fin
    36 00000117 50                  <1>     push ax                  ; AH=02h no debe destruir el caracter pendiente
    37 00000118 B402                <1>     mov ah, 02h
    38 0000011A 30FF                <1>     xor bh, bh
    39 0000011C CD10                <1>     int 10h
    40 0000011E 58                  <1>     pop ax
