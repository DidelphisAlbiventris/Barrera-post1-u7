    42 00000121 30FF                <1>     xor bh, bh
    43 00000123 B90100              <1>     mov cx, 1
    44 00000126 CD10                <1>     int 10h
    45 00000128 FEC2                <1>     inc dl
    46 0000012A EBE6                <1>     jmp .siguiente
    47                              <1> .fin:
    48 0000012C 5E                  <1>     pop si
    49 0000012D 5A                  <1>     pop dx
    50 0000012E 59                  <1>     pop cx
    51 0000012F 5B                  <1>     pop bx
    52 00000130 58                  <1>     pop ax
    53 00000131 C3                  <1>     ret
    54                              <1> 
    55                              <1> ; Solo la PREPARACION usa BIOS. El dibujo posterior usa exclusivamente B800h.
    56                              <1> iniciar_directo:
    57 00000132 B80300              <1>     mov ax, 0003h            ; establecer formato conocido antes de B800h
    58 00000135 CD10                <1>     int 10h
    59 00000137 B402                <1>     mov ah, 02h
    60 00000139 30FF                <1>     xor bh, bh
    61 0000013B BA0017              <1>     mov dx, 1700h           ; cursor de hardware fuera de la zona de trabajo
    62 0000013E CD10                <1>     int 10h
    63 00000140 B800B8              <1>     mov ax, 0B800h
    64 00000143 8EC0                <1>     mov es, ax
    65 00000145 FC                  <1>     cld
