    45 000000D5 FEC2                <1>     inc dl
    46 000000D7 EBE6                <1>     jmp .siguiente
    47                              <1> .fin:
    48 000000D9 5E                  <1>     pop si
    49 000000DA 5A                  <1>     pop dx
