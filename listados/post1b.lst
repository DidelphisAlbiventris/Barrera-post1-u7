    68                              <1> ; AX=atributo:espacio. 2000 palabras = 4000 bytes, sin salir de pagina 0.
    69                              <1> rellenar:
    70 000000F4 31FF                <1>     xor di, di
    71 000000F6 B9D007              <1>     mov cx, 2000
