    13 000000F5 BE[AB01]            <1>     mov si, identidad
    14 000000F8 BA0214              <1>     mov dx, 1402h             ; fila 20, columna 2
    15 000000FB B30B                <1>     mov bl, 0Bh
    16 000000FD E80C00              <1>     call cadena_bios
    17 00000100 BE[C801]            <1>     mov si, asignatura
