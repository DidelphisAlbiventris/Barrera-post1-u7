     4                              <1> ; Preparacion BIOS: modo 03h, pagina 0, 80x25 y limpieza con scroll.
     5                              <1> iniciar_bios:
     6 00000091 B80300              <1>     mov ax, 0003h
     7 00000094 CD10                <1>     int 10h
     8 00000096 B80006              <1>     mov ax, 0600h
