     4                              <1> ; Preparacion BIOS: modo 03h, pagina 0, 80x25 y limpieza con scroll.
     5                              <1> iniciar_bios:
     6 00000074 B80300              <1>     mov ax, 0003h
     7 00000077 CD10                <1>     int 10h
     8 00000079 B80006              <1>     mov ax, 0600h
     9 0000007C B707                <1>     mov bh, 07h
    10 0000007E 31C9                <1>     xor cx, cx
    11 00000080 BA4F18              <1>     mov dx, 184Fh
    12 00000083 CD10                <1>     int 10h
    13 00000085 BE[3B01]            <1>     mov si, identidad
    14 00000088 BA0214              <1>     mov dx, 1402h             ; fila 20, columna 2
    15 0000008B B30B                <1>     mov bl, 0Bh
    16 0000008D E80C00              <1>     call cadena_bios
    17 00000090 BE[5801]            <1>     mov si, asignatura
    18 00000093 BA0215              <1>     mov dx, 1502h
    19 00000096 B307                <1>     mov bl, 07h
    20 00000098 E80100              <1>     call cadena_bios
    21 0000009B C3                  <1>     ret
    22                              <1> 
    23                              <1> ; DS:SI cadena, DH fila, DL columna, BL atributo. Pagina cero.
    24                              <1> ; AH=09h no avanza el cursor: se actualiza DL explicitamente.
    25                              <1> cadena_bios:
    26 0000009C 50                  <1>     push ax
    27 0000009D 53                  <1>     push bx
    28 0000009E 51                  <1>     push cx
    29 0000009F 52                  <1>     push dx
    30 000000A0 56                  <1>     push si
    31 000000A1 FC                  <1>     cld
    32                              <1> .siguiente:
    33 000000A2 AC                  <1>     lodsb
    34 000000A3 84C0                <1>     test al, al
    35 000000A5 7415                <1>     jz .fin
    36 000000A7 50                  <1>     push ax                  ; AH=02h no debe destruir el caracter pendiente
    37 000000A8 B402                <1>     mov ah, 02h
    38 000000AA 30FF                <1>     xor bh, bh
    39 000000AC CD10                <1>     int 10h
    40 000000AE 58                  <1>     pop ax
    41 000000AF B409                <1>     mov ah, 09h
    42 000000B1 30FF                <1>     xor bh, bh
    43 000000B3 B90100              <1>     mov cx, 1
    44 000000B6 CD10                <1>     int 10h
    45 000000B8 FEC2                <1>     inc dl
    46 000000BA EBE6                <1>     jmp .siguiente
    47                              <1> .fin:
    48 000000BC 5E                  <1>     pop si
    49 000000BD 5A                  <1>     pop dx
    50 000000BE 59                  <1>     pop cx
    51 000000BF 5B                  <1>     pop bx
    52 000000C0 58                  <1>     pop ax
    53 000000C1 C3                  <1>     ret
    54                              <1> 
    55                              <1> ; Solo la PREPARACION usa BIOS. El dibujo posterior usa exclusivamente B800h.
    56                              <1> iniciar_directo:
    57 000000C2 B80300              <1>     mov ax, 0003h            ; establecer formato conocido antes de B800h
    58 000000C5 CD10                <1>     int 10h
    59 000000C7 B402                <1>     mov ah, 02h
    60 000000C9 30FF                <1>     xor bh, bh
    61 000000CB BA0017              <1>     mov dx, 1700h           ; cursor de hardware fuera de la zona de trabajo
    62 000000CE CD10                <1>     int 10h
    63 000000D0 B800B8              <1>     mov ax, 0B800h
    64 000000D3 8EC0                <1>     mov es, ax
    65 000000D5 FC                  <1>     cld
    66 000000D6 C3                  <1>     ret
    67                              <1> 
    68                              <1> ; AX=atributo:espacio. 2000 palabras = 4000 bytes, sin salir de pagina 0.
    69                              <1> rellenar:
    70 000000D7 31FF                <1>     xor di, di
    71 000000D9 B9D007              <1>     mov cx, 2000
    72 000000DC FC                  <1>     cld
    73 000000DD F3AB                <1>     rep stosw
    74 000000DF C3                  <1>     ret
    75                              <1> 
    76                              <1> ; DS:SI texto, ES:DI destino, AH atributo; no toca el cursor del BIOS.
    77                              <1> cadena_directa:
    78 000000E0 FC                  <1>     cld
    79                              <1> .otro:
    80 000000E1 AC                  <1>     lodsb
    81 000000E2 84C0                <1>     test al, al
    82 000000E4 7403                <1>     jz .fin
    83 000000E6 AB                  <1>     stosw
    84 000000E7 EBF8                <1>     jmp .otro
    85                              <1> .fin:
    86 000000E9 C3                  <1>     ret
    87                              <1> 
    88                              <1> ; BL=atributo del pie; ES apunta a B800h.
    89                              <1> firma_directa:
    90 000000EA 88DC                <1>     mov ah, bl
    91 000000EC BF840C              <1>     mov di, (20*80+2)*2
    92 000000EF BE[3B01]            <1>     mov si, identidad
    93 000000F2 E8EBFF              <1>     call cadena_directa
    94 000000F5 88DC                <1>     mov ah, bl
    95 000000F7 BF240D              <1>     mov di, (21*80+2)*2
    96 000000FA BE[5801]            <1>     mov si, asignatura
    97 000000FD E8E0FF              <1>     call cadena_directa
    98 00000100 C3                  <1>     ret
