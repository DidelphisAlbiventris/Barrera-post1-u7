    55                              <1> ; Solo la PREPARACION usa BIOS. El dibujo posterior usa exclusivamente B800h.
    56                              <1> iniciar_directo:
    57 00000103 B80300              <1>     mov ax, 0003h            ; establecer formato conocido antes de B800h
